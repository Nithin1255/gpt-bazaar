# PostgreSQL Connection String from Supabase -> Project Settings -> Database -> Connection string (URI)
# Tip: On Render, use the Supabase Session Pooler URI (IPv4) so connections succeed reliably.
DATABASE_URL=""

# Supabase Project Credentials from Project Settings -> API
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public Supabase Storage bucket for product & category images
SUPABASE_STORAGE_BUCKET="catalog-images"

# CORS origins ("*" for mobile + web testing, or comma-separated production URLs e.g. "https://your-admin.vercel.app")
ALLOWED_ORIGINS="*"

# Server port (Render injects PORT automatically)
PORT="8000"

# Firebase Web/Mobile SDK Configuration
EXPO_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
EXPO_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
EXPO_PUBLIC_FIRESTORE_DATABASE_ID="(default)"

# Data source mode: "firestore" (live Starter Tier sync) or "api" (FastAPI backend)
EXPO_PUBLIC_DATA_SOURCE="firestore"

# Optional FastAPI backend URL (used when EXPO_PUBLIC_DATA_SOURCE="api")
# When using a local http:// URL, keep EXPO_PUBLIC_ALLOW_HTTP="true". Switch to "false" once deployed on HTTPS.
EXPO_PUBLIC_API_BASE_URL="http://localhost:8000"
EXPO_PUBLIC_ALLOW_HTTP="true"
